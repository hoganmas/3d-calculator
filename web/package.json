{
  "name": "3d-calculator",
  "private": true,
  "version": "0.1.0",
  "description": "Laplaci — multi-expression 3D polynomial calculator (Chebyshev fit → IDCT → WebGPU march)",
  "homepage": "https://laplaci.com/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/run.mjs",
    "test:flow": "tsx tests/run.mjs flow",
    "test:cloud": "tsx tests/run.mjs cloud",
    "test:isosurface": "tsx tests/run.mjs isosurface",
    "test:integration": "tsx tests/integration/run.mjs",
    "test:coverage": "c8 tsx tests/run.mjs",
    "test:coverage:flow": "c8 tsx tests/run.mjs flow",
    "bench:lobatto": "tsx scripts/bench-lobatto-accuracy.mjs",
    "bench:lobatto:quick": "tsx scripts/bench-lobatto-accuracy.mjs --quick",
    "test:bench:exprShare": "tsx tests/run.mjs exprShare.bench"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "^0.119.0",
    "@floating-ui/dom": "^1.8.0",
    "@mcp-b/webmcp-polyfill": "^5.0.1",
    "mathlive": "^0.110.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/three": "^0.185.4",
    "@webgpu/types": "^0.1.72",
    "c8": "^10.1.3",
    "playwright": "^1.49.0",
    "svelte": "^5.56.10",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
  }
